# Copy this file to .env and fill it in. The .env file is never committed.
# Copiez ce fichier en .env et remplissez-le. Le fichier .env n'est jamais versionné.

# --- Microsoft Entra ID (required / obligatoire) -----------------------------
# Directory (tenant) ID and Application (client) ID of the app registration
# you create in your own tenant (see README, step 1).
TENANT_ID=
CLIENT_ID=

# Address typed in the browser. Must match the redirect URI of the app
# registration: <PUBLIC_URL>/auth/callback
# Adresse saisie dans le navigateur. Doit correspondre à l'URI de redirection.
PUBLIC_URL=http://localhost:8080

# --- Options -----------------------------------------------------------------
# Interface language when the browser language is not available: en, fr
DEFAULT_LANGUAGE=en

# true = search groups by name (needs the extra Graph permission
# GroupMember.Read.All, see README). false = paste the group Object ID.
ENABLE_GROUP_PICKER=false

# Only these accounts may sign in (comma separated). Empty = anyone in the
# tenant may sign in; Intune still enforces each person's own rights.
ALLOWED_USERS=

# Largest installer accepted, in MB.
MAX_DOWNLOAD_MB=8192

# Hours before a new sign-in is required.
SESSION_HOURS=12

# Only for a "Web" app registration with a client secret (not needed with the
# recommended "Mobile and desktop" registration).
CLIENT_SECRET=

# --- Docker ------------------------------------------------------------------
# Owner of the ./config folder on Linux (run `id -u` and `id -g`).
PUID=1000
PGID=1000
# Local port (http://localhost:PORT).
PORT=8080

# --- HTTPS (docker compose --profile https up -d) ----------------------------
# Name colleagues type in their browser, and how the certificate is obtained:
#   TLS=internal                          self-signed, generated automatically
#   TLS=/certs/cert.pem /certs/key.pem    your own certificate (put files in ./certs)
#   TLS=you@example.com                   Let's Encrypt (public DNS name, ports 80/443 open)
# Remember to set PUBLIC_URL=https://<SITE_ADDRESS> above.
SITE_ADDRESS=
TLS=internal
