# HTTPS front door for IntuneAppFastDeploy (docker compose --profile https).
#
# SITE_ADDRESS  the name colleagues type, for example intune-deploy.example.com
# TLS           one of:
#                 internal                     self-signed certificate, generated automatically
#                 /certs/cert.pem /certs/key.pem   your own certificate (files in ./certs)
#                 you@example.com              Let's Encrypt (needs a public DNS name and
#                                              ports 80 and 443 reachable from the Internet)

{$SITE_ADDRESS} {
	tls {$TLS}
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy app:8080
}
